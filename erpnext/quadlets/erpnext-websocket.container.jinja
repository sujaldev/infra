[Unit]
Description=ERPNext Websocket
PartOf=erpnext.target

Requires=erpnext-configurator.service
After=erpnext-configurator.service

[Container]
ContainerName=websocket
Image=erpnext-custom.build
Pull=never
Network=erpnext.network
NetworkAlias=websocket
Volume=sites:/home/frappe/frappe-bench/sites

Exec=node /home/frappe/frappe-bench/apps/frappe/socketio.js

[Service]
Restart=always
