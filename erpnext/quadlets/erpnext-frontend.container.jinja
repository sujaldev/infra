[Unit]
Description=ERPNext Frontend
PartOf=erpnext.target

Requires=erpnext-backend.service erpnext-websocket.service
After=erpnext-backend.service erpnext-websocket.service

[Container]
ContainerName=frontend
Image=localhost/{{ CUSTOM_IMAGE }}:{{ ERPNEXT_VERSION }}
Pull=never
Network=erpnext.network
NetworkAlias=frontend
PublishPort=127.0.0.1:8080:8080/tcp
Volume=sites:/home/frappe/frappe-bench/sites

Exec=nginx-entrypoint.sh

Environment=BACKEND=backend:8000
Environment=CLIENT_MAX_BODY_SIZE={{ CLIENT_MAX_BODY_SIZE }}
Environment=FRAPPE_SITE_NAME_HEADER={{ FRAPPE_SITE_NAME_HEADER }}
Environment=PROXY_READ_TIMEOUT={{ PROXY_READ_TIMEOUT }}
Environment=SOCKETIO=websocket:9000
Environment=UPSTREAM_REAL_IP_ADDRESS={{ UPSTREAM_REAL_IP_ADDRESS }}
Environment=UPSTREAM_REAL_IP_HEADER={{ UPSTREAM_REAL_IP_HEADER }}
Environment=UPSTREAM_REAL_IP_RECURSIVE={{ UPSTREAM_REAL_IP_RECURSIVE }}

[Service]
Restart=always
